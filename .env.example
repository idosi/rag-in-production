# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Optional overrides (defaults live in src/rag/config.py)
# LLM_MODEL=claude-sonnet-5-5   # chosen by make eval-answers (step 2c)
# LLM_EFFORT=medium
# TOP_K=5
# RETRIEVAL_MODE=rerank        # vector | hybrid | rerank | hybrid_rerank (see src/rag/retrieval.py)
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# CANDIDATE_K=10
# OLLAMA_URL=http://localhost:11434   # for models written as ollama:<name> in ANSWER_MODELS
# REWRITER_MODEL=claude-haiku-5-5   # used only by the rewrite / rewrite_rerank modes

# API protection (src/rag/security.py). EMPTY API_KEYS = /ask is open (OK for local dev only).
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEYS=key1,key2            # several keys allow rotation
# RATE_LIMIT_PER_MINUTE=20      # per caller; 0 = off

# Cost control (src/rag/cache.py, src/rag/spend.py)
# ANSWER_CACHE_MAX_ITEMS=500    # 0 = answer cache off
# ANSWER_CACHE_TTL_SECONDS=3600
# DAILY_BUDGET_USD=5            # new questions get 503 after this; 0 = no limit
